{
  "name": "acr-innovative-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ACR Innovative website: NestJS server-side rendered site + admin API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:content": "tsx prisma/seed/initial-content.ts",
    "seed:admin": "tsx prisma/seed/admin-user.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "dotenv": "18.0.7",
    "hbs": "4.3.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/hbs": "4.0.5",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
