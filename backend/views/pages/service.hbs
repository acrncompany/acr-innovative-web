<main>
	<div class="uk-section">
		<div class="uk-container">
			<div class="uk-grid uk-flex uk-flex-center">
				<div class="uk-width-3-4@m">
					<div class="in-icon-wrap primary-color uk-margin-small-bottom"><i class="{{service.icon}} fa-lg"></i></div>
					<p class="uk-text-small uk-text-muted uk-text-uppercase uk-margin-remove-bottom">{{service.category.title}}</p>
					<h1 class="uk-margin-small-top uk-margin-remove-bottom">{{service.title}}</h1>
					<p class="uk-text-lead uk-text-muted uk-margin-small-top">{{service.summary}}</p>
					<div class="in-richtext uk-margin-medium-top">{{{service.bodyHtml}}}</div>
					<div class="uk-margin-large-top uk-flex uk-flex-wrap" style="gap:12px;">
						<a href="{{b.cta_button_url}}" class="uk-button uk-button-primary uk-border-rounded">{{b.cta_button}}</a>
						<a href="/services" class="uk-button uk-button-default uk-border-rounded">All Services</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>
