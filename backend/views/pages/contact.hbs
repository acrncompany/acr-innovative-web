<main>
	<!-- section content begin -->
	<div class="uk-section">
		<div class="uk-container">
			<div class="uk-grid">
				<div class="uk-width-3-5@m">
					<h1 class="uk-margin-remove-bottom">{{hl b.hero_title}}</h1>
					<p class="uk-text-lead uk-text-muted uk-margin-small-top">{{b.hero_lead}}</p>
				</div>
				<div class="uk-width-1-1@m uk-margin-large-top">
					<div class="uk-grid uk-grid-large" data-uk-grid>
						<div class="uk-width-1-3@m">

							{{#each site.offices}}
							<h2 class="uk-h4 {{#unless @first}}uk-margin-medium-top {{/unless}}uk-margin-remove-bottom"><i class="fas fa-map-marker-alt uk-margin-small-right uk-text-primary"></i>{{shortName}}</h2>
							<p class="uk-margin-small-top uk-text-muted">{{lines contactAddress}}</p>
							<p class="uk-margin-remove-top"><a href="tel:{{phoneRaw}}" class="uk-link-text">{{phone}}</a></p>
							{{/each}}

							<h2 class="uk-h4 uk-margin-medium-top uk-margin-remove-bottom"><i class="fas fa-envelope uk-margin-small-right uk-text-primary"></i>{{b.email_title}}</h2>
							<p class="uk-margin-small-top"><a href="mailto:{{site.contactEmail}}" class="uk-link-text">{{site.contactEmail}}</a></p>

						</div>
						<div class="uk-width-2-3@m">
							<div class="uk-margin-medium-left in-margin-remove-left@s">
								<form id="contact-form" class="uk-form uk-grid-small" data-uk-grid method="post" action="/api/public/contact" data-success="{{b.form_success}}">
									<div class="uk-width-1-2@s uk-inline">
										<span class="uk-form-icon fas fa-user fa-sm"></span>
										<input class="uk-input uk-border-rounded" id="name" name="name" type="text" placeholder="Full name" aria-label="Full name" required maxlength="150">
									</div>
									<div class="uk-width-1-2@s uk-inline">
										<span class="uk-form-icon fas fa-envelope fa-sm"></span>
										<input class="uk-input uk-border-rounded" id="email" name="email" type="email" placeholder="Email address" aria-label="Email address" required maxlength="200">
									</div>
									<div class="uk-width-1-2@s uk-inline">
										<span class="uk-form-icon fas fa-phone fa-sm"></span>
										<input class="uk-input uk-border-rounded" id="phone" name="phone" type="tel" placeholder="Phone number (optional)" aria-label="Phone number" maxlength="50">
									</div>
									<div class="uk-width-1-2@s uk-inline">
										<span class="uk-form-icon fas fa-building fa-sm"></span>
										<input class="uk-input uk-border-rounded" id="company" name="company" type="text" placeholder="Company name (optional)" aria-label="Company name" maxlength="200">
									</div>
									<div class="uk-width-1-1 uk-inline">
										<span class="uk-form-icon fas fa-pen fa-sm"></span>
										<input class="uk-input uk-border-rounded" id="subject" name="subject" type="text" placeholder="Subject" aria-label="Subject" required maxlength="250">
									</div>
									<div class="uk-width-1-1">
										<textarea class="uk-textarea uk-border-rounded" id="message" name="message" rows="6" placeholder="Tell us about your requirement..." aria-label="Message" required maxlength="5000"></textarea>
									</div>
									<!-- honeypot: real visitors never see or fill this -->
									<div class="in-form-honeypot" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
									<div class="uk-width-1-1">
										<button class="uk-button uk-button-primary uk-border-rounded uk-align-right" id="sendemail" type="submit" name="submit">{{b.form_button}}</button>
									</div>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- section content end -->
</main>
