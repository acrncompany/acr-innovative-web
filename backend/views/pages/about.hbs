<main>
	<!-- intro + mission/vision/values -->
	<div class="uk-section">
		<div class="uk-container">

			<!-- Intro: text left, image right -->
			<div class="uk-grid uk-grid-large uk-flex uk-flex-middle" data-uk-grid>
				<div class="uk-width-1-2@m">
					<h1 class="uk-margin-remove-bottom">{{hl b.hero_title}}</h1>
					<p class="uk-text-lead uk-text-muted uk-margin-small-top">{{b.hero_lead}}</p>
					<p class="uk-text-muted">{{b.hero_p1}}</p>
					<p class="uk-text-muted">{{b.hero_p2}}</p>
				</div>
				<div class="uk-width-1-2@m uk-visible@m">
					{{#if b.hero_image}}<img class="uk-border-rounded uk-box-shadow-medium uk-width-1-1" src="{{b.hero_image.src}}" alt="{{b.hero_image.alt}}" width="{{b.hero_image.width}}" height="{{b.hero_image.height}}" loading="lazy">{{/if}}
				</div>
			</div>

			<!-- Mission / Vision / Values -->
			<div class="uk-grid uk-grid-large uk-child-width-1-3@m uk-margin-large-top" data-uk-grid>
				{{#each pillars}}
				<div class="uk-flex uk-flex-left">
					<div class="uk-margin-right">
						<div class="in-icon-wrap primary-color">
							<i class="{{icon}} fa-lg"></i>
						</div>
					</div>
					<div>
						<h2 class="uk-h3">{{title}}</h2>
						<p class="uk-margin-remove-bottom">{{body}}</p>
					</div>
				</div>
				{{/each}}
			</div>

		</div>
	</div>

	<!-- leadership & team -->
	<div class="uk-section uk-section-muted">
		<div class="uk-container">
			<div class="uk-grid">
				<div class="uk-width-1-1">
					<div class="uk-card uk-card-default uk-border-rounded uk-card-body uk-box-shadow-medium">
						<div class="uk-grid uk-flex uk-flex-middle" data-uk-grid>
							<div class="uk-width-1-1 uk-text-center uk-margin-bottom">
								<h2 class="uk-margin-remove-bottom">{{hl b.team_title}}</h2>
								<p class="uk-text-muted uk-margin-small-top">{{b.team_lead}}</p>
							</div>
							<div class="uk-width-1-2@m">
								{{#each team}}
								<div class="uk-flex uk-flex-left">
									<div class="uk-margin-right">
										{{#if photoImg}}
										<img class="uk-border-circle" src="{{photoImg.src}}" alt="{{photoImg.alt}}" width="64" height="64" loading="lazy" style="object-fit:cover;">
										{{else}}
										<div class="in-icon-wrap primary-color" style="width:64px;height:64px;font-size:1.6rem;">
											<i class="{{icon}}"></i>
										</div>
										{{/if}}
									</div>
									<div>
										<p class="uk-text-small uk-text-muted uk-text-uppercase uk-margin-remove-bottom">{{role}}</p>
										<h3 class="uk-margin-small-top uk-margin-remove-bottom">{{name}}</h3>
										{{paragraphs bio 'uk-text-muted'}}
									</div>
								</div>
								{{/each}}
							</div>
							<div class="uk-width-1-2@m">
								<div class="uk-grid uk-child-width-1-2@s uk-grid-small" data-uk-grid>
									{{#each disciplines}}
									<div>
										<div class="uk-card uk-card-default uk-card-small uk-card-body uk-border-rounded uk-box-shadow-small">
											<div class="in-icon-wrap primary-color uk-margin-small-bottom" style="width:40px;height:40px;font-size:1rem;">
												<i class="{{icon}}"></i>
											</div>
											<h4 class="uk-h5 uk-margin-small-top uk-margin-remove-bottom">{{title}}</h4>
											<p class="uk-text-small uk-text-muted uk-margin-small-top">{{body}}</p>
										</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- track record -->
	<div class="uk-section">
		<div class="uk-container">
			<div class="uk-grid uk-flex uk-flex-center">
				<div class="uk-width-3-4@m">
					<div class="uk-grid uk-flex uk-flex-middle" data-uk-grid>
						<div class="uk-width-1-2@m">
							<p class="uk-h4 uk-text-muted">{{b.track_kicker}}</p>
							<h2 class="uk-h1 uk-margin-medium-bottom">{{hl b.track_title}}</h2>
							<a href="{{b.track_button_url}}" class="uk-button uk-button-primary uk-border-rounded">{{b.track_button}}</a>
						</div>
						<div class="uk-width-1-2@m">
							{{#each stats}}
							<div class="uk-margin-large" data-uk-grid>
								<div class="uk-width-1-3@m">
									<div class="uk-h1 uk-text-primary uk-text-right@m">
										{{#if textValue}}{{textValue}}{{else}}<span class="count" data-counter-end="{{value}}">0</span>{{suffix}}{{/if}}
									</div>
									<hr class="uk-divider-small uk-text-right@m">
								</div>
								<div class="uk-width-expand@m">
									<h3 class="uk-h4">{{label}}</h3>
									<p>{{description}}</p>
								</div>
							</div>
							{{/each}}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>
