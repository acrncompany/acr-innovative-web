# Copy to .env (never commit .env). On Hostinger set these in the hPanel Node.js app settings.
NODE_ENV=production
PORT=3000
# Public base URL, no trailing slash (used for canonical/OG/sitemap)
SITE_URL=https://acrinnovative.com
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"
# Admin-uploaded images (served at /uploads) and private CVs (never served). Keep OUTSIDE the app folder.
UPLOAD_DIR=/home/USER/acr-data/uploads
PRIVATE_DIR=/home/USER/acr-data/private
# Long random string (at least 32 characters in production), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Used only by `npm run seed:admin` (creates the admin if none exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin login cookie is Secure (HTTPS-only) automatically when NODE_ENV=production. For local HTTPS testing set COOKIE_SECURE=true.
COOKIE_SECURE=
# Optional: read seed images from another folder (default: backend/prisma/seed-assets, committed to git)
SEED_ASSETS_DIR=
# 1 = trust the first proxy hop (Hostinger) so rate limits/logs see the real client IP
TRUST_PROXY=1
# Email alerts for contact/job forms (Hostinger mailbox SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
